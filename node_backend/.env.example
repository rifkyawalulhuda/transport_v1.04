DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=trucking
# DATABASE_URL=mysql://root:your_password@localhost:3306/trucking
JWT_SECRET=your_jwt_secret
PORT=3000
WIALON_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_TOKEN=your_wialon_token
WIALON_LOGIN_FLAGS=13
WIALON_SESSION_TTL_MS=2700000
WIALON_TIMEOUT_MS=20000
GEOAPIFY_API_KEY=your_geoapify_api_key
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode/reverse
GEOAPIFY_TIMEOUT_MS=6000
REVERSE_GEOCODE_CACHE_TTL_MS=86400000
WIALON_MONTHLY_DISTANCE_CACHE_TTL_MS=600000
GEOFENCE_TRACKING_INTERVAL_MS=60000
DEFAULT_FINISH_GEOFENCE_NAME=Sankyu
# Same-zone finish (Sankyu): leave evidence lookback before planned departure (default 4h).
# Early trip+return still finishes after planned dep (#44394); min-away still blocks #44390.
# GEOFENCE_FINISH_LEAVE_LOOKBACK_SEC=14400
# GEOFENCE_FINISH_MIN_AWAY_SEC=1200
# GEOFENCE_FINISH_MIN_AWAY_M=1000
# Auto-finish unfinished SPK by zone distance + age since planned departure:
# ≤60km → 3d, ≤100km → 7d, >100km → 10d; no distance → fallback 3d.
# Set GEOFENCE_AGE_FINISH_DRY_RUN=1 to log only (no INSERT).
# GEOFENCE_AGE_FINISH_SHORT_KM=60
# GEOFENCE_AGE_FINISH_MID_KM=100
# GEOFENCE_AGE_FINISH_DAYS_SHORT=3
# GEOFENCE_AGE_FINISH_DAYS_MID=7
# GEOFENCE_AGE_FINISH_DAYS_LONG=10
# GEOFENCE_AGE_FINISH_DAYS_FALLBACK=3
# GEOFENCE_AGE_FINISH_LOOKBACK_DAYS=60
# GEOFENCE_AGE_FINISH_DRY_RUN=0
# CORS: set to your production domain (e.g. https://app.example.com)
# Leave empty or unset to allow all origins (development mode)
ALLOWED_ORIGIN=
